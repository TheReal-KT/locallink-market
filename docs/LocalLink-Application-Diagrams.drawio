        <mxCell id="crc-title" value="LocalLink Market - CRC Cards" style="text;html=1;strokeColor=none;fillColor=none;fontSize=24;fontStyle=1;fontColor=#1A2126;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="520" height="40" as="geometry" />
        </mxCell>
        <mxCell id="crc-note" value="Main classes, responsibilities, and collaborators for the simplified PHP/MySQL e-commerce app." style="text;html=1;strokeColor=none;fillColor=none;fontSize=13;fontColor=#66746F;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="760" height="30" as="geometry" />
        </mxCell>
        <mxCell id="crc-user" value="&lt;b&gt;Customer/User&lt;/b&gt;&lt;br&gt;&lt;br&gt;Responsibilities:&lt;br&gt;- Register or log in&lt;br&gt;- Browse products&lt;br&gt;- Place orders&lt;br&gt;&lt;br&gt;Collaborators:&lt;br&gt;Order, Product" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0C796D;fontSize=13;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="130" width="240" height="180" as="geometry" />
        </mxCell>
        <mxCell id="crc-product" value="&lt;b&gt;Product Catalog&lt;/b&gt;&lt;br&gt;&lt;br&gt;Responsibilities:&lt;br&gt;- List products by category&lt;br&gt;- Show product details&lt;br&gt;- Track price and stock&lt;br&gt;&lt;br&gt;Collaborators:&lt;br&gt;Category, Admin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EBAA44;fontSize=13;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="340" y="130" width="260" height="180" as="geometry" />
        </mxCell>
        <mxCell id="crc-order" value="&lt;b&gt;Order&lt;/b&gt;&lt;br&gt;&lt;br&gt;Responsibilities:&lt;br&gt;- Store checkout details&lt;br&gt;- Calculate total amount&lt;br&gt;- Reduce stock after purchase&lt;br&gt;&lt;br&gt;Collaborators:&lt;br&gt;Customer, Product" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0C796D;fontSize=13;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="350" width="240" height="180" as="geometry" />
        </mxCell>
        <mxCell id="crc-admin" value="&lt;b&gt;Admin Dashboard&lt;/b&gt;&lt;br&gt;&lt;br&gt;Responsibilities:&lt;br&gt;- Add products&lt;br&gt;- View reports&lt;br&gt;- Review recent orders&lt;br&gt;&lt;br&gt;Collaborators:&lt;br&gt;Product, Order, User" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EBAA44;fontSize=13;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="340" y="350" width="260" height="180" as="geometry" />
        </mxCell>
        <mxCell id="crc-db" value="&lt;b&gt;Database Layer&lt;/b&gt;&lt;br&gt;&lt;br&gt;Responsibilities:&lt;br&gt;- Connect to MySQL&lt;br&gt;- Read/write users, products, orders&lt;br&gt;- Provide fallback sample data&lt;br&gt;&lt;br&gt;Collaborators:&lt;br&gt;All modules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E5F3EC;strokeColor=#0C796D;fontSize=13;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="640" y="240" width="280" height="190" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
